<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00D4FF"/>
      <stop offset="100%" stop-color="#0066FF"/>
    </linearGradient>
  </defs>

  <!-- Fond -->
  <rect width="512" height="512" rx="120" fill="#0F172A"/>

  <!-- Poteau gauche -->
  <rect x="90" y="120" width="20" height="270" rx="10" fill="#FFFFFF"/>

  <!-- Portail -->
  <rect x="130" y="150" width="210" height="180"
        rx="20"
        fill="url(#g)"
        stroke="#4FC3FF"
        stroke-width="8"/>

  <!-- Barreaux -->
  <g stroke="white" stroke-width="8" opacity="0.9">
    <line x1="170" y1="170" x2="170" y2="310"/>
    <line x1="210" y1="170" x2="210" y2="310"/>
    <line x1="250" y1="170" x2="250" y2="310"/>
    <line x1="290" y1="170" x2="290" y2="310"/>
  </g>

  <!-- Mouvement coulissant -->
  <path d="M370 240 H450"
        stroke="#00FF88"
        stroke-width="20"
        stroke-linecap="round"/>

  <path d="M420 205 L460 240 L420 275"
        fill="none"
        stroke="#00FF88"
        stroke-width="20"
        stroke-linecap="round"
        stroke-linejoin="round"/>
</svg>
